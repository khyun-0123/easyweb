{
  "manifest_version": 3,
  "name": "EasyWeb — 쉬운 화면",
  "version": "0.10.0",
  "description": "현재 페이지에서 주요 기능을 찾아 큰 버튼으로 안내합니다. 원본 화면으로 언제든 돌아갈 수 있습니다.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_title": "EasyWeb 쉬운 화면 열기 / 닫기"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+E",
        "mac": "Alt+Shift+E"
      },
      "description": "쉬운 화면 열기 / 닫기"
    }
  }
}
