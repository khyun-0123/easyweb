{
  "name": "easyweb",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "복잡한 웹페이지의 주요 기능을 찾아 쉬운 화면으로 안내하는 Chrome 확장 프로그램",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && playwright test",
    "test:live": "npm run build && node scripts/check-live.mjs",
    "demo": "node scripts/serve-demo.mjs",
    "evaluate": "node scripts/evaluate.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "verify": "node scripts/verify.mjs --with-core",
    "test:a11y": "node scripts/a11y-check.mjs",
    "test:tasks": "node scripts/check-tasks-live.mjs",
    "study:analyze": "node scripts/analyze-study.mjs",
    "package": "node scripts/package.mjs --output-dir=output/run003"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/chrome": "^0.3.5",
    "axe-core": "^4.14.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
