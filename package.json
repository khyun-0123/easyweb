{
  "name": "easyweb",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "복잡한 웹페이지의 주요 기능을 찾아 쉬운 화면으로 안내하는 Chrome 확장 프로그램",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && playwright test",
    "test:live": "npm run build && node scripts/check-live.mjs",
    "demo": "node scripts/serve-demo.mjs",
    "evaluate": "node scripts/evaluate.mjs",
    "benchmark": "node scripts/benchmark.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/chrome": "^0.3.5",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
